# .ebextensions/02_commands.config
# Demonstra o uso de container_commands com leader_only.
#
# DIFERENÇA ENTRE commands E container_commands:
#   commands:           executa ANTES do deploy do código (fase de setup do SO)
#   container_commands: executa DEPOIS do deploy, ANTES do start da aplicação
#
# leader_only: true -> o comando roda em APENAS UMA instância do cluster (a líder)
# Padrão clássico para: migrations de banco de dados, seed de dados iniciais,
# limpeza de cache, etc. — operações que não devem se repetir em cada instância.

packages:
  yum:
    # Instalar pacotes extras do SO antes do deploy
    jq: []

commands:
  # Exemplo: comando que roda em TODAS as instâncias (sem leader_only)
  01_log_deploy_inicio:
    command: "echo '[DEPLOY] Iniciando deploy em: $(date)' >> /var/log/eb-deploy.log"

container_commands:
  # Exemplo: migration — roda apenas na instância líder
  01_migration_banco:
    command: |
      echo "[MIGRATION] Este comando roda apenas na instância líder - simulando migration de banco" >> /var/log/eb-deploy.log
      echo "[MIGRATION] Data: $(date)" >> /var/log/eb-deploy.log
    leader_only: true

  # Exemplo: warm-up do cache — roda em TODAS as instâncias
  02_warmup_cache:
    command: |
      echo "[WARMUP] Aquecendo cache nesta instância..." >> /var/log/eb-deploy.log
    leader_only: false
