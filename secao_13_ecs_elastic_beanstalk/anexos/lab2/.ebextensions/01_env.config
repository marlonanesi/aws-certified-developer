# .ebextensions/01_env.config
# Configura variáveis de ambiente do aplicativo no Elastic Beanstalk.
# Processado em ordem alfabética — prefixo 01 garante que roda primeiro.
# Estas configurações substituem (ou complementam) as definidas no console.

option_settings:
  # Namespace: configurações do ambiente da aplicação
  aws:elasticbeanstalk:application:environment:
    APP_VERSION: "1.0"
    APP_ENV: "producao"
    EQUIPE: "backend-dvac02"

  # Namespace: configurações do processo web (porta padrão)
  aws:elasticbeanstalk:container:python:
    WSGIPath: "app:app"

  # Namespace: configurações do health check
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: "/health"
    MatcherHTTPCode: "200"
